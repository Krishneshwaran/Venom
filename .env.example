# Activity Monitor Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# API Keys
# ============================================================================

# Groq API Key (for AI suggestions)
# Get your key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Resend API Key (for email notifications)
# Get your key from: https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# ============================================================================
# Notification Settings
# ============================================================================

# Email to receive weekly reports
NOTIFICATION_EMAIL=your-email@example.com

# ============================================================================
# Detection Settings
# ============================================================================

# Detection model: mock, mediapipe, or yolo
# Use 'mock' for testing without ML models
DETECTION_MODEL=mock

# Logs directory
LOGS_DIR=logs

# ============================================================================
# Notes
# ============================================================================

# - GROQ_API_KEY: Required only if you want AI-powered suggestions
#   Without it, the app will use rule-based fallback suggestions
#
# - RESEND_API_KEY & NOTIFICATION_EMAIL: Required only for email reports
#   Without them, reports will be shown in console only
#
# - DETECTION_MODEL: Start with 'mock' to test the system
#   Switch to 'mediapipe' when you're ready to use real detection
